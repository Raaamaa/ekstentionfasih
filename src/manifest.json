{
  "action": {
    "default_title": "Fasih Approval by AdnanPW"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "js": [
        "content/fasih-context.js"
      ],
      "matches": [
        "https://fasih-sm.bps.go.id/app/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "description": "Panel approve/reject Fasih SE2026 \u00e2\u20ac\u201d M1 read-only (XHR-first, dry-run).",
  "host_permissions": [
    "https://fasih-sm.bps.go.id/*"
  ],
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "Fasih Approval SE2026 by AdnanPW",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "version": "0.8.2"
}